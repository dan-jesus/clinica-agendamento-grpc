# Ambiente local / demonstração. Não use estas credenciais em produção.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# URL/usuário/senha do PostgreSQL usado por cada microsserviço via Spring Data
# JPA. Por padrão (sem definir estas variáveis) os serviços apontam para o
# container local "postgres" acima. Para usar uma instância externa/nuvem,
# defina as três variáveis de cada serviço (a senha é obrigatória: o
# docker-compose falha explicitamente se ela não estiver definida).
# CADASTRO_DB_URL=jdbc:postgresql://SEU_HOST:5432/clinica_cadastro
# CADASTRO_DB_USER=postgres
# CADASTRO_DB_PASSWORD=
# AGENDA_DB_URL=jdbc:postgresql://SEU_HOST:5432/clinica_agenda
# AGENDA_DB_USER=postgres
# AGENDA_DB_PASSWORD=

APP_ADMIN_NAME=Recepção Clínica
APP_ADMIN_EMAIL=admin@clinica.com
APP_ADMIN_PASSWORD=admin123

# Deve ter pelo menos 32 bytes.
JWT_SECRET=troque-esta-chave-jwt-por-uma-chave-secreta-com-mais-de-32-bytes
JWT_EXPIRATION_MINUTES=120
